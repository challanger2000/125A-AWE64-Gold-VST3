+bool Synth::PrepareRealtime(uint32_t maxOutputFrames)
+{
+    m_rtPrepared = false;
+    if (maxOutputFrames == 0 || maxOutputFrames > 1024) return false;
+    size_t largest = 1;
+    for (const auto& loaded : m_banks)
+    {
+        const auto& bank = *loaded.bank;
+        for (const auto& preset : bank.presets)
+        {
+            size_t total = 0;
+            for (const auto& zone : preset.zones)
+            {
+                if (zone.instrument < 0 ||
+                    static_cast<size_t>(zone.instrument) >= bank.instruments.size())
+                    continue;
+                const size_t n = bank.instruments[zone.instrument].zones.size();
+                if (n > 4096 - total) return false;
+                total += n;
+            }
+            largest = std::max(largest, total);
+        }
+    }
+    // All heap work happens before the host activates process().
+    m_rtRegions.reserve(largest);
+    m_rtParams.reserve(largest);
+    m_rtVoiceIds.reserve(largest);
+    if (!m_core.PrepareRealtime(maxOutputFrames)) return false;
+    m_rtPrepared = true;
     return true;
 }
 
