+bool Emu8000Core::PrepareRealtime(uint32_t maxOutputFrames)
+{
+    if (maxOutputFrames == 0 || maxOutputFrames > 1024 ||
+        m_outputRate < 8000 || m_outputRate > 192000) return false;
+    // 44100/8000 is the worst supported native/output ratio.
+    // +8 covers carry phase and the two interpolation taps.
+    const size_t cap = static_cast<size_t>(std::ceil(
+        (44100.0 / 8000.0) * maxOutputFrames)) + 8u;
+    m_nativeL.reserve(cap); m_nativeR.reserve(cap);
+    m_sendReverb.reserve(cap); m_sendChorus.reserve(cap);
+    m_rtMaxOutputFrames = maxOutputFrames;
+    return true;
+}
